# 환경변수 설정 예시 (.env.example → .env 로 복사 후 수정)

# ── 서버 설정 ──────────────────────────────────
APP_NAME=지능형 분리수거 도우미 API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── 모델 설정 ──────────────────────────────────
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
MODEL_CACHE_DIR=./models

# ── 이미지 업로드 제한 ─────────────────────────
MAX_IMAGE_SIZE_MB=10
CONFIDENCE_THRESHOLD=0.15
